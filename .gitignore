# =====================================================================
# Git Ignore Rules — Pharma Sales Analysis & Forecasting
# =====================================================================

# ── Trained Model Binaries & Artifacts ──────────────────────────────
data/outputs/trained_models/
*.pkl
*.keras
*.h5
*.joblib
*.sav
*.pth
*.pt
*.onnx

# ── Python Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python Bytecode & Cache ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Operating System & IDE Files ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Temporary & Log Files ────────────────────────────────────────────
*.log
*.tmp
scratch/
.system_generated/

# ── Secrets & credentials — never commit these ──────────────────────
infra/*.json
infra/secrets/
*-key.json
*serviceaccount*.json
*service-account*.json
.env
*.pem
infra/.demo-api-key.txt

# ── Terraform state & local plugin cache ────────────────────────────
# State files can contain sensitive resource attributes; the plugin
# cache is huge and machine-specific. The lock file (.terraform.lock.hcl)
# IS meant to be committed — it's just a provider version pin.
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.tfstate.lock.info
